{
  "name": "@buildonspark/spark-vite-app",
  "private": true,
  "version": "0.0.134",
  "type": "module",
  "scripts": {
    "start": "cross-env NODE_ENV=development vite",
    "build": "tsc -b tsconfig.json tsconfig.node.json && vite build",
    "format:fix": "prettier . --write",
    "format": "prettier . --check",
    "lint:fix": "eslint --fix .",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:integration": "playwright test --grep-invert @ssp",
    "test:integration:ssp": "playwright install --with-deps chromium && cross-env HERMETIC_TEST=true VITE_SPARK_TARGET=LOCAL playwright test --grep @ssp"
  },
  "dependencies": {
    "@buildonspark/spark-sdk": "0.9.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@buildonspark/issuer-sdk": "0.1.45",
    "@lightsparkdev/eslint-config": "^0.0.1",
    "@playwright/test": "1.60.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.25.0",
    "globals": "^15.15.0",
    "prettier": "^3.7.4",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
