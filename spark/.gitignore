/.vscode/launch.json
!/.vscode/extensions.json
!/.vscode/settings.json

# Output from building the SO (i.e. go build ./bin/operator)
/operator

# Custom golangci-lint binary built from .custom-gcl.yml (includes the fmtlint plugin)
/bin/golangci-lint-spark

# Output from building entfieldlint (i.e. go build -o bin/entfieldlint ./tools/entfieldlint/cmd/entfieldlint)
/bin/entfieldlint

# Output from building dbseed (i.e. go build ./cmd/dbseed)
/dbseed
/cmd/dbseed/dbseed

# Air hot-reload artifacts
/tmp/
/build-errors.log

# dbseed local snapshots — large .pgdump files from prod-scale seeds
/cmd/dbseed/snapshots/
