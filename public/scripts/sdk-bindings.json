{
  "schema_version": 2,
  "manifest": "sdks/js/sdk-bindings-manifest.json",
  "tool_versions": {
    "android_api": "21",
    "android_ndk": "r25c",
    "protoc": "33.2",
    "wasm_pack": "0.13.1",
    "windows_llvm": "20.1.8"
  },
  "bare_tool_versions": {
    "bare-make": "1.6.3",
    "cmake-bare": "1.6.5",
    "cmake-cargo": "0.0.5",
    "cmake-npm": "1.1.0",
    "cmake-runtime": "4.1.1",
    "cmake-toolchains": "1.8.4",
    "ninja-runtime": "1.13.1"
  },
  "source_hash_transforms": {
    "sdks/js/packages/spark-frost-bare-addon/package.json": {
      "remove_top_level_json_fields": ["version"]
    }
  },
  "managed_output_patterns": [
    "sdks/js/packages/spark-sdk/src/spark-bindings/wasm/**",
    "sdks/js/packages/spark-sdk/src/token-primitives-bindings/wasm/**",
    "sdks/js/packages/spark-sdk/android/src/main/java/uniffi/**",
    "sdks/js/packages/spark-sdk/android/src/main/jniLibs/**",
    "sdks/js/packages/spark-sdk/ios/spark_frost.swift",
    "sdks/js/packages/spark-sdk/ios/spark_frostFFI.xcframework/**",
    "sdks/js/packages/spark-sdk/ios/spark_token_primitives.swift",
    "sdks/js/packages/spark-sdk/ios/spark_token_primitivesFFI.xcframework/**",
    "sdks/js/packages/spark-frost-bare-addon/prebuilds/**",
    "sdks/js/packages/spark-sdk/third-party/**"
  ],
  "executable_output_patterns": [
    "sdks/js/packages/spark-sdk/android/src/main/jniLibs/**"
  ],
  "force_all_triggers": [
    ".github/workflows/sdk-bindings.yaml",
    ".github/workflows/bare-prebuild.yaml",
    ".github/workflows/run-spark-hermetic-test.yaml"
  ],
  "trusted_producer_paths": [
    ".github/workflows/bare-prebuild.yaml",
    ".github/workflows/run-spark-hermetic-test.yaml",
    ".github/workflows/sdk-bindings.yaml",
    "public/actions/setup-node-yarn-install/**",
    "public/actions/yarn-install/**",
    "public/scripts/sdk-bindings.json",
    "public/scripts/build-sdk-android-bindings.sh",
    "public/scripts/build-sdk-ios-bindings.sh",
    "public/scripts/sdk-bindings.js",
    "public/scripts/tests/test-sdk-bindings.js",
    "public/scripts/verify-android-min-api.sh",
    "public/scripts/verify-android-page-size.sh",
    "scripts/sdk-bindings/commit-sdk-bindings.js",
    "scripts/sdk-bindings/tests/test-commit-sdk-bindings.js",
    "sdks/js/packages/spark-frost-bare-addon/scripts/normalize-win32-prebuilds.js",
    "sdks/js/packages/spark-sdk/wasm/patch-token-primitives-wasm-browser.mjs",
    "sdks/js/packages/spark-sdk/wasm/patch-token-primitives-wasm-nodejs.mjs",
    "sdks/js/packages/spark-sdk/wasm/patch-wasm-browser.mjs",
    "sdks/js/packages/spark-sdk/wasm/patch-wasm-browser.test.mjs",
    "sdks/js/packages/spark-sdk/wasm/patch-wasm-nodejs.mjs",
    "sdks/js/packages/spark-sdk/wasm/patch-wasm-nodejs.test.mjs",
    "signer/spark-frost-uniffi/build-bindings.sh",
    "signer/spark-token-primitives-uniffi/build-bindings.sh",
    "public/scripts/sdk-licenses.js",
    "public/scripts/sdk-licenses/**"
  ],
  "common_inputs": [
    "public/scripts/sdk-bindings.json",
    "public/scripts/sdk-bindings.js",
    "signer/.cargo/config.toml",
    "signer/Cargo.lock",
    "signer/Cargo.toml",
    "signer/rust-toolchain.toml",
    "public/scripts/sdk-licenses.js",
    "public/scripts/sdk-licenses/licenses/**",
    "public/scripts/sdk-licenses/upstream/**"
